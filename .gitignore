# Rust
/target
**/*.rs.bk

# Deepwork runtime state (see .ignore negations for tooling visibility)
.slim/deepwork/

# recorded-local real-session corpus (diff-ext C1/C2 privacy iron law:
# recorded data NEVER enters a commit — only aggregates in reports)
tools/diff/corpus/tui/recorded-local/*
!tools/diff/corpus/tui/recorded-local/README.md

# Channel 9 real-plugin payload registry (W8: repo-local persistence,
# provisioned by tools/diff/realchain/fetch_plugin_payload.sh; the
# encrypted-corpus CI bundle may optionally carry a copy).
tools/diff/realchain/plugin-payload/

# OS
.DS_Store

# IDE
.idea/
.vscode/
.worktrees/
.git-identity

# Porting-process archives & runtime state (kept locally outside git)
.superpowers/
*.log
tools/bin/
tools/parity/tui-diff/cache/
.test-logs/
__pycache__/
docs/GAPS-AND-PITFALLS.md
.superpowers/
