; Vendored for oc-syntax (R-01 spike) — DO NOT EDIT BY HAND.
; Source: https://github.com/tree-sitter/tree-sitter-javascript/blob/v0.23.1/queries/highlights.scm
; Tag: v0.23.1 (contemporaneous with the tree-sitter-typescript 0.23.2 crate).
; Composed into the typescript highlight query at compile time: the
; tree-sitter-typescript repo's own highlights.scm carries only the TS-specific
; patterns — the ecma base patterns (const/function/string/comment/...) live in
; the javascript query. This mirrors nvim-treesitter's
; `; inherits: javascript` composition (see the parsers-config.ts warning about
; including query dependencies), against the typescript grammar (a superset of
; the v0.23.1 javascript node set the query was written for).
; R-01b: this file is now ALSO the `javascript` registry entry's highlight
; query, verbatim — oc-syntax pins the tree-sitter-javascript crate at
; v0.23.1 exactly (the tag this file was vendored from), so grammar and
; query stay ABI-coherent for both consumers.

; Variables
;----------

(identifier) @variable

; Properties
;-----------

(property_identifier) @property

; Function and method definitions
;--------------------------------

(function_expression
  name: (identifier) @function)
(function_declaration
  name: (identifier) @function)
(method_definition
  name: (property_identifier) @function.method)

(pair
  key: (property_identifier) @function.method
  value: [(function_expression) (arrow_function)])

(assignment_expression
  left: (member_expression
    property: (property_identifier) @function.method)
  right: [(function_expression) (arrow_function)])

(variable_declarator
  name: (identifier) @function
  value: [(function_expression) (arrow_function)])

(assignment_expression
  left: (identifier) @function
  right: [(function_expression) (arrow_function)])

; Function and method calls
;--------------------------

(call_expression
  function: (identifier) @function)

(call_expression
  function: (member_expression
    property: (property_identifier) @function.method))

; Special identifiers
;--------------------

((identifier) @constructor
 (#match? @constructor "^[A-Z]"))

([
    (identifier)
    (shorthand_property_identifier)
    (shorthand_property_identifier_pattern)
 ] @constant
 (#match? @constant "^[A-Z_][A-Z\\d_]+$"))

((identifier) @variable.builtin
 (#match? @variable.builtin "^(arguments|module|console|window|document)$")
 (#is-not? local))

((identifier) @function.builtin
 (#eq? @function.builtin "require")
 (#is-not? local))

; Literals
;---------

(this) @variable.builtin
(super) @variable.builtin

[
  (true)
  (false)
  (null)
  (undefined)
] @constant.builtin

(comment) @comment

[
  (string)
  (template_string)
] @string

(regex) @string.special
(number) @number

