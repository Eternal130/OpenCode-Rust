{
  "id": "resize",
  "description": "Boot at the script size, then resize through 100x28 and 60x20 and back; every step compares the post-resize grid.",
  "stub": "text",
  "mode": "exact",
  "steps": [
    { "label": "boot", "wait_ms": 12000 },
    { "label": "dismiss", "keys": ["esc"], "wait_ms": 1000 },
    { "label": "grow", "resize": { "cols": 100, "rows": 28 }, "wait_ms": 2500 },
    { "label": "shrink", "resize": { "cols": 60, "rows": 20 }, "wait_ms": 2500 },
    { "label": "restore", "resize": { "cols": 80, "rows": 24 }, "wait_ms": 2500 },
    { "label": "exit", "keys": ["leader", "q"], "wait_ms": 2500 }
  ]
}
