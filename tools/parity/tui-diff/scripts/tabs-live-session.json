    { "label": "tab-add-press", "mouse": { "action": "press", "x": 33, "y": 0 }, "wait_ms": 700 },
    { "label": "tab-add-release", "mouse": { "action": "release", "x": 33, "y": 0 }, "wait_ms": 1500 },
    { "label": "new-tab-settled", "wait_ms": 1000 },
    { "label": "type-2", "text": "Seed tab two", "wait_ms": 500 },
