    { "label": "models-open", "keys": ["enter"], "wait_ms": 1800 },
    { "label": "models-filter", "text": "fake", "wait_ms": 800 },
    { "label": "models-select", "keys": ["enter"], "wait_ms": 2000 },
    { "label": "variant-dismiss", "keys": ["esc"], "wait_ms": 900 },
    { "label": "type-1", "text": "Seed tab one", "wait_ms": 500 },
    { "label": "submit-1", "keys": ["enter"], "wait_ms": 6000 },
    { "label": "reply-1-settled", "wait_ms": 2000 },
