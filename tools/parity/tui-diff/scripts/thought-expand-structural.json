{
  "id": "thought-expand-structural",
  "description": "Structural-mode mandate, strengthened thought-expand: pin the fake model, submit a reasoning prompt, then toggle the thought block \u2014 mouse press+release on the thought header expands it, capture the expanded geometry, a second press+release collapses it, capture again. Every step records BOTH the EXACT and STRUCTURAL diffs (the rig computes both per step; mode picks the headline), so the expanded/collapsed run digests (text extents, margins, vertical gaps) are on the record in each mode.",
  "stub": "reasoning",
  "mode": "struct",
  "steps": [
    {
      "label": "boot",
      "wait_ms": 12000
    },
    {
      "label": "dismiss",
      "keys": [
        "esc"
      ],
      "wait_ms": 1000
    },
    {
      "label": "models-cmd",
      "text": "/models",
      "wait_ms": 800
    },
    {
      "label": "models-open",
      "keys": [
        "enter"
      ],
      "wait_ms": 1800
    },
    {
      "label": "models-filter",
      "text": "fake",
      "wait_ms": 800
    },
    {
      "label": "models-select",
      "keys": [
        "enter"
      ],
      "wait_ms": 2000
    },
    {
      "label": "variant-dismiss",
      "keys": [
        "esc"
      ],
      "wait_ms": 900
    },
    {
      "label": "type",
      "text": "Think carefully",
      "wait_ms": 500
    },
    {
      "label": "submit",
      "keys": [
        "enter"
      ],
      "wait_ms": 7000
    },
    {
      "label": "collapsed",
      "wait_ms": 2500
