{
  "id": "type-edit-submit",
  "description": "Pin the fake model via /models (the boot model-line divergence is itself a reported finding), then type a prompt, edit it (backspace + retype), submit; the stub's fixed reply must render identically (structural mode: model text is masked).",
  "stub": "text",
  "mode": "struct",
  "steps": [
    {
      "label": "boot",
      "wait_ms": 12000
    },
    {
      "label": "dismiss",
      "keys": [
        "esc"
      ],
      "wait_ms": 1000
    },
    {
      "label": "models-cmd",
      "text": "/models",
      "wait_ms": 800
    },
    {
      "label": "models-open",
      "keys": [
        "enter"
      ],
      "wait_ms": 1800
    },
    {
      "label": "models-filter",
      "text": "fake",
      "wait_ms": 800
    },
    {
      "label": "models-select",
      "keys": [
        "enter"
      ],
      "wait_ms": 2000
    },
    {
      "label": "variant-dismiss",
      "keys": [
        "esc"
      ],
      "wait_ms": 900
    },
    {
      "label": "type",
      "text": "Say hello world",
      "wait_ms": 600
    },
    {
      "label": "edit",
      "keys": [
        "backspace",
        "backspace",
        "backspace",
        "backspace",
        "backspace"
      ],
      "wait_ms": 500
    },
    {
      "label": "retype",
      "text": "hello.",
      "wait_ms": 500
    },
    {
      "label": "submit",
      "keys": [
        "enter"
      ],
      "wait_ms": 6000
    },
    {
      "label": "settled-reply",
      "wait_ms": 2000
    },
    {
      "label": "exit",
      "keys": [
        "leader",
        "q"
      ],
      "wait_ms": 2500
    }
  ]
}
